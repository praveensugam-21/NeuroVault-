# NeuroVault — Self-Hosted Deployment Environment Configuration
# ─────────────────────────────────────────────────────────────
# STEP 1: Copy this file:  cp .env.example .env
# STEP 2: Fill in the required values below
# STEP 3: Run:            docker compose up -d
# ─────────────────────────────────────────────────────────────


# ── PostgreSQL Database ──────────────────────────────────────────────────────
# These credentials are used by both the PostgreSQL container and the backend.
POSTGRES_DB=neurovault
POSTGRES_USER=nv_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password


# ── JWT Session Security ─────────────────────────────────────────────────────
# Generate a secure random key:
#   Linux/Mac:  openssl rand -hex 32
#   Windows:    python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32


# ── AES-256 Field Encryption ─────────────────────────────────────────────────
# Used to encrypt sensitive fields (Aadhaar, PAN, bank account numbers) at rest.
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_run_fernet_generate_key


# ── Gemini AI Integration ────────────────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ── Storage Paths (inside Docker volumes — do not change unless you know why) ─
UPLOAD_DIRECTORY=/data/uploads
CHROMADB_PATH=/data/chromadb
MODEL_CACHE=/data/model-cache
