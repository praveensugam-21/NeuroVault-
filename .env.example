# IRIS — Self-Hosted Deployment Environment Configuration
# ─────────────────────────────────────────────────────────────
# STEP 1: Copy this file to .env:     cp .env.example .env
# STEP 2: Fill in ALL required values below
# STEP 3: Launch:                     docker compose up -d
# ─────────────────────────────────────────────────────────────
# Security Note: NEVER commit your .env file to version control.
# Your .gitignore already excludes it.
# ─────────────────────────────────────────────────────────────


# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Used by both the PostgreSQL container and the IRIS backend.
POSTGRES_DB=iris
POSTGRES_USER=iris_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password


# ── JWT Session Security ──────────────────────────────────────────────────────
# Generate a secure key (minimum 32 bytes of entropy):
#   Linux/Mac:  openssl rand -hex 32
#   Windows:    python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# JWT token lifetimes (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30


# ── AES-256 Field Encryption ──────────────────────────────────────────────────
# Encrypts sensitive fields (Aadhaar, PAN, bank numbers) at rest using Fernet.
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_run_fernet_generate_key


# ── Google OAuth (Optional) ───────────────────────────────────────────────────
# Enables Google Sign-In button on the login page.
# Setup:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (Web application type)
#   3. Add your frontend URL to Authorized JavaScript origins
#      e.g. http://localhost:5173 for development
#   4. Paste the Client ID below
# Leave empty to disable Google Sign-In entirely.
GOOGLE_CLIENT_ID=


# ── CORS Allowed Origins (Production Only) ────────────────────────────────────
# Comma-separated list of origins allowed to make cross-origin requests.
# Example: https://iris.yourdomain.com,https://app.yourdomain.com
# Leave empty to allow localhost variants (development mode only).
ALLOWED_ORIGINS=


# ── Gemini AI Integration (Optional Cloud Feature) ───────────────────────────
# Enables Gemini-powered responses for complex queries.
# All document data is PII-masked before being sent to the API.
# Get a free API key: https://aistudio.google.com/app/apikey
# Leave empty to keep ALL responses fully local (recommended for privacy).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50


# ── Storage Paths ─────────────────────────────────────────────────────────────
# These paths are bind-mounted as Docker volumes. Do not change unless you
# understand the docker-compose volume mapping.
UPLOAD_DIRECTORY=/data/uploads
CHROMADB_PATH=/data/chromadb
MODEL_CACHE=/data/model-cache


# ── Application Mode ──────────────────────────────────────────────────────────
# Set to "production" in production environments.
# "development" enables more verbose logging.
ENV_MODE=development


# ── OCR Configuration ─────────────────────────────────────────────────────────
# Set to true to enable local EasyOCR (GPU or CPU) for scanned documents.
# Disable if running on a resource-constrained server.
ENABLE_LOCAL_OCR=true
