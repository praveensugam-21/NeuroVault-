# IRIS AI Environment Configuration

# App Mode
# Options: "development" or "production"
ENV_MODE=development
# Security
# Run `openssl rand -hex 32` to generate a secret key
JWT_SECRET_KEY=supersecretjwtkeyforhackathonauth123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For default Local Mode: sqlite:///./iris.db
# For Docker Production Mode: postgresql://user:password@localhost:5432/iris
DATABASE_URL=sqlite:///./iris.db

# Vector Database Settings
CHROMA_PERSIST_DIR=./vector_store

# Uploads Storage
UPLOADS_DIR=./uploads

# Feature Flags
ENABLE_LOCAL_OCR=true
ENABLE_VOICE_TRANSCRIPTION=true
